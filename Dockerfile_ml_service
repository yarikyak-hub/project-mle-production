# Используем официальный легковесный образ Python
FROM python:3.12-slim

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файл с зависимостями
COPY requirements.txt .

# Устанавливаем зависимости
RUN pip install --no-cache-dir -r requirements.txt

# Копируем папку services внутрь контейнера (там код, модель и .env)
COPY services/ ./services/

# Указываем, что контейнер слушает порт 8000
EXPOSE 8000

# Команда для запуска сервера. 
# --host 0.0.0.0 обязателен, чтобы к сервису можно было обратиться извне контейнера.
CMD ["uvicorn", "services.ml_service.main:app", "--host", "0.0.0.0", "--port", "8000"]